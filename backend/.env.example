# Copy to backend/.env and edit. Never commit the real .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://acbridge:acbridge@localhost:5432/acbridge
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-production
ACCESS_TOKEN_MINUTES=60
# Comma-separated towns the platform currently serves (lower-case).
SUPPORTED_TOWNS=buea,limbe
MIN_ENDORSEMENTS_FOR_SKILL_VERIFICATION=2
RATE_LIMIT_ENABLED=true
EVIDENCE_UPLOAD_DIR=uploads
MAX_EVIDENCE_BYTES=5242880
# Your frontend's address(es), comma-separated. Must match exactly (scheme + host + port).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Payments module (see PAYMENTS.md). Commission model: artisan_upfront (default) or customer_split.
COMMISSION_MODEL=artisan_upfront
QUOTE_TTL_HOURS=24
DISPUTE_WINDOW_HOURS=48
# Signs provider webhooks (HMAC-SHA256). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=dev-only-webhook-secret-change-me
PAY_RATE_LIMIT_CALLS=5
PAY_RATE_LIMIT_WINDOW_SECONDS=600
